{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts", "./deploy/**/*.ts", "./scripts/**/*.ts", "hardhat.config.ts"],
  "files": ["./hardhat.config.ts"]
}
